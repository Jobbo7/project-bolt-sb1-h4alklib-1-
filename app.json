{
  "expo": {
    "name": "PartsForge",
    "slug": "partsforge-app",
    "owner": "jobbo7",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#070A12"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.partsforge.trade"
    },
    "android": {
      "package": "com.partsforge.trade",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070A12"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
            ]
    },
    "extra": {
      "eas": {
        "projectId": "385c20a9-a5a8-469f-8768-f6a6f1ba94dd"
      }
    }
  }
}

